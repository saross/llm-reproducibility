{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Adversarial review output",
  "description": "Structured-output contract for adversarial-reviewer spawns (agent definition v1.1), supplied at spawn by the reproduction-execute workflow. Dimension names and the PASS/CONCERN and CONFIRMED/QUALIFIED/CHALLENGED scales follow the adversarial-review framework v1.1 (pushed instrument). The orchestrator persists the payload as <attempt_dir>/adversarial-review.json (the reviewer writes nothing). The framework's overall rule (0 concerns CONFIRMED; 1-2 QUALIFIED; 3+ CHALLENGED) and the agent definition's ambiguity default are checked post-run by scripts/reproduction-lane.py, not here. Runtime-safe: no top-level allOf or conditionals.",
  "version": "1.0",
  "type": "object",
  "required": ["status", "paper_slug", "receipts"],
  "additionalProperties": false,
  "properties": {
    "status": {"type": "string", "enum": ["OK", "ESCALATE"]},
    "escalate_reason": {"type": ["string", "null"]},
    "paper_slug": {"type": "string", "minLength": 1},
    "receipts": {
      "type": "object",
      "required": ["instrument_versions", "instrument_receipts", "agent_version", "model_id", "pulled_files_read"],
      "additionalProperties": false,
      "properties": {
        "instrument_versions": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "instrument_receipts": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "agent_version": {"type": "string", "minLength": 1},
        "model_id": {"type": "string", "minLength": 1},
        "pulled_files_read": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "artefacts_reviewed": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "dimensions": {
      "type": "object",
      "required": ["provenance", "quantitative_claims", "scope_completeness", "confirmation_bias", "methodological_soundness"],
      "additionalProperties": false,
      "properties": {
        "provenance": {"$ref": "#/definitions/dimension"},
        "quantitative_claims": {"$ref": "#/definitions/dimension"},
        "scope_completeness": {"$ref": "#/definitions/dimension"},
        "confirmation_bias": {"$ref": "#/definitions/dimension"},
        "methodological_soundness": {"$ref": "#/definitions/dimension"}
      }
    },
    "overall": {"type": "string", "enum": ["CONFIRMED", "QUALIFIED", "CHALLENGED"]},
    "verdict_challenge": {
      "type": "object",
      "required": ["executor_verdict", "reviewer_supports_verdict", "rationale"],
      "additionalProperties": false,
      "properties": {
        "executor_verdict": {"type": "string", "enum": ["SUCCESSFUL", "PARTIAL", "FAILED", "BLOCKED", "NOT_FOUND"]},
        "reviewer_supports_verdict": {"type": "boolean"},
        "rationale": {"type": "string", "minLength": 1}
      }
    },
    "spot_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check", "method", "result"],
        "additionalProperties": false,
        "properties": {
          "check": {"type": "string", "minLength": 1},
          "method": {"type": "string", "minLength": 1},
          "result": {"type": "string", "minLength": 1}
        }
      }
    },
    "recommendations": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "definitions": {
    "dimension": {
      "type": "object",
      "required": ["verdict", "findings"],
      "additionalProperties": false,
      "properties": {
        "verdict": {"type": "string", "enum": ["PASS", "CONCERN"]},
        "findings": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
